# انسخ هذا الملف إلى .env قبل التشغيل المحلي
# copy .env.example .env

# رابط قاعدة البيانات (Neon/PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# سر جلسات المستخدم (غيّره إلى قيمة طويلة وعشوائية)
SESSION_SECRET=change-this-to-a-long-random-secret

# اختياري: منفذ التطبيق
PORT=5000

# اختياري: أحجام اتصال قاعدة البيانات
DB_POOL_MAX=10
DB_SESSION_POOL_MAX=3
